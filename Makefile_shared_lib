# Makefile for testing shared library loading

CC = gcc
CFLAGS = -Wall -g -fPIC
LDFLAGS = -lm

# Directories
VM_DIR = vm
BYTECODE_DIR = bytecode
PARSER_DIR = parser
LEXER_DIR = lexer
ERROR_DIR = error
DYNARRAY_DIR = dynarray

# Source files for the VM library
VM_SRCS = $(VM_DIR)/vm.c \
          $(BYTECODE_DIR)/bytecode.c \
          $(PARSER_DIR)/parser.c \
          $(LEXER_DIR)/lexer.c \
          $(ERROR_DIR)/error.c \
          $(DYNARRAY_DIR)/dynarray.c

# Object files
VM_OBJS = $(VM_SRCS:.c=.o)

# Platform detection
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Linux)
    SHARED_EXT = .so
    SHARED_FLAGS = -shared
    DL_FLAGS = -ldl
endif
ifeq ($(UNAME_S),Darwin)
    SHARED_EXT = .so
    SHARED_FLAGS = -dynamiclib
    DL_FLAGS = -ldl
endif
ifeq ($(OS),Windows_NT)
    SHARED_EXT = .dll
    SHARED_FLAGS = -shared
    DL_FLAGS = 
endif

# Targets
all: math$(SHARED_EXT) test_shared_lib

# Build object files
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Build the math shared library
math$(SHARED_EXT): demo_math_lib.o $(VM_OBJS)
	$(CC) $(SHARED_FLAGS) -o $@ demo_math_lib.o $(VM_OBJS) $(LDFLAGS)
	@echo "Built math library: $@"

# Build the test program
test_shared_lib: test_shared_lib.o $(VM_OBJS)
	$(CC) -o $@ test_shared_lib.o $(VM_OBJS) $(LDFLAGS) $(DL_FLAGS)
	@echo "Built test program: $@"

# Run the test
test: all
	@echo "=== Running Shared Library Test ==="
	@echo ""
	./test_shared_lib
	@echo ""
	@echo "=== Test Complete ==="

# Clean up
clean:
	rm -f $(VM_OBJS) demo_math_lib.o test_shared_lib.o
	rm -f math$(SHARED_EXT) test_shared_lib
	rm -f math.so math.dll math.dylib

.PHONY: all test clean