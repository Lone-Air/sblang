// Test function similar to demo1
function func_1(argument1, argument2) {
    variable1 = argument1;
    print("Initial variable1:", variable1);
    
    while(variable1 <= argument2) {
        print("In while loop, variable1:", variable1);
        if(!(argument2 % argument1 == 2)) {
            variable1 = variable1 + 2;
        }
        else {
            variable1 = variable1 + 3;
        }
    }
    
    print("After while loop, variable1:", variable1);
    
    for(i = 0; i < 10; i = i + 1) {
        variable1 = variable1 + i;
    }
    
    print("After for loop, variable1:", variable1);
    return variable1;
}

// Test the function
result = func_1(1, 2);
print("Function result:", result);

// Test logical NOT on the result  
b = !result;
print("Logical NOT of result:", b);